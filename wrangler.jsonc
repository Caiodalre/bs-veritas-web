{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bs-veritas-web",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "bsveritas.com.br",
      "custom_domain": true,
    },
  ],
  "build": {
    "command": "pnpm build",
    "watch_dir": ["src", "public", "next.config.ts", "worker"],
  },
  "vars": {
    "QUOTE_EXPECTED_HOSTNAME": "bsveritas.com.br",
  },
  "secrets": {
    "required": ["TURNSTILE_SECRET_KEY"],
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/*/__next.*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "9328daf3a8434323b2adaa889cfc0f7f",
    },
  ],
  "ratelimits": [
    {
      "name": "QUOTE_RATE_LIMITER",
      "namespace_id": "24091701",
      "simple": {
        "limit": 5,
        "period": 10,
      },
    },
  ],
}
