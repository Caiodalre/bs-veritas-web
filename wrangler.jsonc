{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bs-veritas-web",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./worker/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "bsveritas.com.br",
      "custom_domain": true,
    },
  ],
  "build": {
    "command": "pnpm build",
    "watch_dir": ["src", "public", "next.config.ts", "worker"],
  },
  "vars": {
    "CAMPAIGN_ADMIN_ENABLED": "true",
    "QUOTE_EXPECTED_HOSTNAME": "bsveritas.com.br",
    "QUOTE_DLQ_MONITOR_ENABLED": "true",
    "QUOTE_NOTIFICATION_ENABLED": "true",
    "QUOTE_ADMIN_ENABLED": "true",
    "OPERATIONS_ADMIN_ENABLED": "true",
    "QUOTE_RETENTION_CLEANUP_ENABLED": "true",
    "QUOTE_SUBMISSION_ENABLED": "true",
  },
  "triggers": {
    "crons": ["17 6 * * *", "47 */6 * * *"],
  },
  "secrets": {
    "required": ["CAMPAIGN_ACCESS_AUD", "CAMPAIGN_ACCESS_TEAM_DOMAIN", "TURNSTILE_SECRET_KEY"],
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/*/__next.*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "9328daf3a8434323b2adaa889cfc0f7f",
    },
  ],
  "r2_buckets": [
    {
      "binding": "CAMPAIGN_ASSETS",
      "bucket_name": "bs-veritas-campaigns",
    },
  ],
  "send_email": [
    {
      "name": "QUOTE_NOTIFICATION_EMAIL",
      "destination_address": "bsveritascorretora@gmail.com",
      "allowed_sender_addresses": ["contato@bsveritas.com.br"],
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUOTE_NOTIFICATION_QUEUE",
        "queue": "bs-veritas-quote-notifications",
      },
      {
        "binding": "QUOTE_NOTIFICATION_DLQ",
        "queue": "bs-veritas-quote-notifications-dlq",
      },
    ],
    "consumers": [
      {
        "queue": "bs-veritas-quote-notifications",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 8,
        "dead_letter_queue": "bs-veritas-quote-notifications-dlq",
        "retry_delay": 60,
      },
    ],
  },
  "ratelimits": [
    {
      "name": "QUOTE_RATE_LIMITER",
      "namespace_id": "24091701",
      "simple": {
        "limit": 5,
        "period": 10,
      },
    },
  ],
  "env": {
    "preview": {
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "triggers": {
        "crons": [],
      },
      "vars": {
        "CAMPAIGN_ADMIN_ENABLED": "false",
        "QUOTE_EXPECTED_HOSTNAME": "quote-preview-bs-veritas-web-preview.caio-dalre.workers.dev",
        "QUOTE_DLQ_MONITOR_ENABLED": "false",
        "QUOTE_NOTIFICATION_ENABLED": "false",
        "QUOTE_ADMIN_ENABLED": "false",
        "OPERATIONS_ADMIN_ENABLED": "false",
        "QUOTE_RETENTION_CLEANUP_ENABLED": "false",
        "QUOTE_SUBMISSION_ENABLED": "false",
      },
    },
  },
}
