      "checkConstraints": {
        "quote_requests_full_name_check": {
          "name": "quote_requests_full_name_check",
          "value": "char_length(btrim(\"quote_requests\".\"full_name\")) between 2 and 150"
        },
        "quote_requests_phone_check": {
          "name": "quote_requests_phone_check",
          "value": "\"quote_requests\".\"phone\" ~ '^[0-9]{10,15}$'"
        },
        "quote_requests_email_check": {
          "name": "quote_requests_email_check",
          "value": "\"quote_requests\".\"email\" = lower(btrim(\"quote_requests\".\"email\")) and position('@' in \"quote_requests\".\"email\") > 1"
        },
        "quote_requests_insurance_type_check": {
          "name": "quote_requests_insurance_type_check",
          "value": "\"quote_requests\".\"insurance_type\" in ('auto', 'residencial', 'empresarial', 'vida', 'viagem', 'outras-solucoes')"
        },
        "quote_requests_city_check": {
          "name": "quote_requests_city_check",
          "value": "\"quote_requests\".\"city\" is null or (char_length(btrim(\"quote_requests\".\"city\")) between 1 and 120 and \"quote_requests\".\"city\" = btrim(\"quote_requests\".\"city\"))"
        },
        "quote_requests_message_check": {
          "name": "quote_requests_message_check",
          "value": "\"quote_requests\".\"message\" is null or (char_length(btrim(\"quote_requests\".\"message\")) between 1 and 1000 and \"quote_requests\".\"message\" = btrim(\"quote_requests\".\"message\"))"
        },
        "quote_requests_privacy_policy_version_check": {
          "name": "quote_requests_privacy_policy_version_check",
          "value": "char_length(btrim(\"quote_requests\".\"privacy_policy_version\")) between 1 and 32 and \"quote_requests\".\"privacy_policy_version\" = btrim(\"quote_requests\".\"privacy_policy_version\")"
        },
        "quote_requests_retention_window_check": {
          "name": "quote_requests_retention_window_check",
          "value": "\"quote_requests\".\"retention_expires_at\" > \"quote_requests\".\"created_at\""
        }
      },
      "isRLSEnabled": false
    }
