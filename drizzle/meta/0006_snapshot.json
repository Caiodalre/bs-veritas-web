        "insurance_sales_insurer_check": {
          "name": "insurance_sales_insurer_check",
          "value": "char_length(btrim(\"insurance_sales\".\"insurer\")) between 2 and 120 and \"insurance_sales\".\"insurer\" = btrim(\"insurance_sales\".\"insurer\")"
        },
        "insurance_sales_insurance_type_check": {
          "name": "insurance_sales_insurance_type_check",
          "value": "char_length(btrim(\"insurance_sales\".\"insurance_type\")) between 2 and 64 and \"insurance_sales\".\"insurance_type\" = btrim(\"insurance_sales\".\"insurance_type\")"
        },
        "insurance_sales_policy_number_check": {
          "name": "insurance_sales_policy_number_check",
          "value": "\"insurance_sales\".\"policy_number\" is null or (char_length(btrim(\"insurance_sales\".\"policy_number\")) between 1 and 80 and \"insurance_sales\".\"policy_number\" = btrim(\"insurance_sales\".\"policy_number\"))"
        },
        "insurance_sales_premium_amount_check": {
          "name": "insurance_sales_premium_amount_check",
          "value": "\"insurance_sales\".\"premium_amount\" >= 0"
        },
        "insurance_sales_commission_amount_check": {
          "name": "insurance_sales_commission_amount_check",
          "value": "\"insurance_sales\".\"brokerage_commission_amount\" >= 0 and \"insurance_sales\".\"brokerage_commission_amount\" <= \"insurance_sales\".\"premium_amount\""
        },
        "insurance_sales_employee_payout_amount_check": {
          "name": "insurance_sales_employee_payout_amount_check",
          "value": "\"insurance_sales\".\"employee_payout_amount\" >= 0 and \"insurance_sales\".\"employee_payout_amount\" <= \"insurance_sales\".\"brokerage_commission_amount\""
        },
        "insurance_sales_payout_paid_at_check": {
          "name": "insurance_sales_payout_paid_at_check",
          "value": "(\"insurance_sales\".\"payout_status\" = 'paid' and \"insurance_sales\".\"payout_paid_at\" is not null) or (\"insurance_sales\".\"payout_status\" = 'pending' and \"insurance_sales\".\"payout_paid_at\" is null)"
